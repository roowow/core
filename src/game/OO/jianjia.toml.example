# 蒹葭 AI 陪伴服务配置文件
# 使用方法：复制为 jianjia.toml，按实际环境填写后启动服务
#   python3 jianjia_chat.py --config jianjia.toml
#
# 依赖：Python 3.11+ 内置 tomllib；旧版本需 pip install tomli

# ── 服务全局参数 ────────────────────────────────────────────────────────────────

[service]
soul_file     = "jianjia_soul.md"    # 核心灵魂文件（身份/性格/风格）
knowledge_dir = "jianjia_knowledge"  # 知识模块目录（所有 .md 按序加载）
log_dir       = "logs"               # 对话日志目录（JSON Lines，按启动时间命名）
max_turns     = 10                   # 每玩家内存中保留的最近对话轮数
history_ttl   = 1800                 # 玩家对话上下文空闲超时（秒），超时后清空
server_name   = "石牛湖"             # 当前服务器名称，注入 AI 上下文
server_phase  = "1.10 艾泽拉斯的风暴" # 当前版本阶段，注入 AI 上下文
# pid_file    = "jianjia.pid"        # 可选，默认脚本同目录下 jianjia.pid
                                      # 改 soul/knowledge 文件后执行
                                      # `python3 jianjia_chat.py --reload`
                                      # 即可热加载，不用重启进程

# ── Ollama ──────────────────────────────────────────────────────────────────────

[ollama]
url   = "http://127.0.0.1:11434/api/chat"
model = "qwen3:32b"
context_tokens = 8192   # 这个模型在Ollama里实际配置的num_ctx，填错的话日志里的
                        # "上下文占比"就是错的——去 ollama show <model> 或者
                        # Modelfile 里确认真实的 num_ctx 是多少

# ── Redis ───────────────────────────────────────────────────────────────────────

[redis]
host = "127.0.0.1"
port = 6379

# ── 各 Realm 数据库配置 ─────────────────────────────────────────────────────────
#
# 每个 realm 独立配置，支持不同主机 / 账号 / 库名。
# logs_db  ：用于读取小队/团队聊天历史 & 持久化玩家/公会记忆（jianjia_memory 表）
# world_db ：用于查询物品/任务/NPC 信息（item_template / quest_template / creature_template）
# 两者均为可选，不配置则对应功能禁用，不影响核心对话流程。

[realms.1]

[realms.1.logs_db]
host = "127.0.0.1"
port = 3306
user = "root"
pass = "your_password"
name = "logs"

[realms.1.world_db]
host = "127.0.0.1"
port = 3306
user = "root"
pass = "your_password"
name = "mangos"

# 如有第二个服务器，取消下方注释并填写

# [realms.2]
#
